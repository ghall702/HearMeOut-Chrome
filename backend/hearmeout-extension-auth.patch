diff --git a/src/routes/api/public/v1/extension.signout.ts b/src/routes/api/public/v1/extension.signout.ts
new file mode 100644
index 0000000..9ed4dee
--- /dev/null
+++ b/src/routes/api/public/v1/extension.signout.ts
@@ -0,0 +1,17 @@
+import { createFileRoute } from "@tanstack/react-router";
+import { revokeExtensionSession } from "@/lib/extension-auth.server";
+import { json } from "@/lib/api-http.server";
+
+// POST /api/public/v1/extension/signout — revokes the extension's own session (Bearer access token).
+export const Route = createFileRoute("/api/public/v1/extension/signout")({
+  server: {
+    handlers: {
+      POST: async ({ request }) => {
+        const m = /^Bearer\s+(\S+)$/i.exec((request.headers.get("authorization") ?? "").trim());
+        if (!m || m[1]!.split(".").length !== 3) return json({ error: "unauthorised" }, 401);
+        await revokeExtensionSession(m[1]!).catch(() => {});
+        return json({ ok: true });
+      },
+    },
+  },
+});
diff --git a/src/routes/api/public/v1/extension.token.ts b/src/routes/api/public/v1/extension.token.ts
new file mode 100644
index 0000000..7ae6646
--- /dev/null
+++ b/src/routes/api/public/v1/extension.token.ts
@@ -0,0 +1,34 @@
+import { createFileRoute } from "@tanstack/react-router";
+import { z } from "zod";
+import { exchangeGrant, refreshExtensionSession } from "@/lib/extension-auth.server";
+import { json } from "@/lib/api-http.server";
+
+// POST /api/public/v1/extension/token — Chrome extension session exchange and refresh.
+//   { "grant_type": "token_hash", "token_hash": "…" }       → new session
+//   { "grant_type": "refresh_token", "refresh_token": "…" } → rotated session
+// Response: { access_token, refresh_token, expires_at, user: { id, email, name, avatar_url } }
+export const Route = createFileRoute("/api/public/v1/extension/token")({
+  server: {
+    handlers: {
+      POST: async ({ request }) => {
+        const parsed = z
+          .discriminatedUnion("grant_type", [
+            z.object({ grant_type: z.literal("token_hash"), token_hash: z.string().min(10).max(200) }),
+            z.object({ grant_type: z.literal("refresh_token"), refresh_token: z.string().min(6).max(500) }),
+          ])
+          .safeParse(await request.json().catch(() => null));
+        if (!parsed.success) return json({ error: "invalid_request" }, 400);
+        try {
+          const s =
+            parsed.data.grant_type === "token_hash"
+              ? await exchangeGrant(parsed.data.token_hash)
+              : await refreshExtensionSession(parsed.data.refresh_token);
+          return json(s);
+        } catch (e) {
+          const code = e instanceof Error && e.message === "not_allowed" ? "not_allowed" : "invalid_grant";
+          return json({ error: code }, code === "not_allowed" ? 403 : 401);
+        }
+      },
+    },
+  },
+});
diff --git a/src/routes/api/public/v1/recordings.$id.upload-url.ts b/src/routes/api/public/v1/recordings.$id.upload-url.ts
